# Required
BETTER_AUTH_SECRET=        # any long random string
BETTER_AUTH_URL=           # e.g. https://caretaker-expense.fly.dev (http://localhost:3100 locally)
DATA_DIR=                  # where the SQLite file and photos live; /data on Fly

# Optional sign-in providers. A button only appears when its keys are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=           # the Services ID
APPLE_CLIENT_SECRET=       # the signed JWT made from your .p8 key
APPLE_APP_BUNDLE_IDENTIFIER=
LINE_CLIENT_ID=            # LINE Login channel ID
LINE_CLIENT_SECRET=
WHATSAPP_TOKEN=            # WhatsApp Cloud API permanent token
WHATSAPP_PHONE_ID=         # the sender phone number ID
WHATSAPP_TEMPLATE=login_code   # an approved Authentication template
WHATSAPP_TEMPLATE_LANG=en

# Sign in with Apple: the server signs the client secret itself
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_KEY_P8=

# Web push (npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Apple push for the iOS app
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY_P8=

# Feedback: accounts that can review and answer feedback in the app (comma separated emails)
OWNER_EMAILS=
# Feedback API for scripts/feedback.mjs (random, at least 32 characters)
FEEDBACK_TOKEN=

# Plans and payments (off until BILLING_PROVIDER is set). See README ¡÷ Plans.
# BILLING_PROVIDER=ecpay        # or stripe
# BILLING_START=2026-12-01      # the day billing goes on: older families' 30-day trials count from here
# ECPAY_ENV=prod                # leave unset to use ECPay's public test merchants
# ECPAY_MERCHANT_ID=
# ECPAY_HASH_KEY=
# ECPAY_HASH_IV=
# ECPAY_INVOICE_MERCHANT_ID=
# ECPAY_INVOICE_HASH_KEY=
# ECPAY_INVOICE_HASH_IV=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
